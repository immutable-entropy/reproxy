#!/bin/sh
# Pre-removal: stop the MCP service before the binary it runs disappears.
#
# reproxy-mcp is a user service, so there is no single instance to stop: each
# logged-in user may have one. Both steps below are best-effort, because a
# user manager may not be running (or may not be reachable) and that must not
# block the removal.
set -e

stop_user_services() {
	command -v systemctl >/dev/null 2>&1 || return 0

	# Stop any instance that is actually running. loginctl lists users with a
	# live session; --machine=<user>@.host reaches their user manager.
	if command -v loginctl >/dev/null 2>&1; then
		for u in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
			[ -n "$u" ] || continue
			systemctl --user --machine="${u}@.host" stop reproxy-mcp.service \
				>/dev/null 2>&1 || true
		done
	fi

	# Drop any system-wide enablement (set by `systemctl --global enable`),
	# so no symlink is left pointing at a unit that is about to go away.
	systemctl --global disable reproxy-mcp.service >/dev/null 2>&1 || true
}

case "$1" in
	remove|deconfigure)
		stop_user_services
		;;

	upgrade|failed-upgrade)
		# Leave the service running across an upgrade; the new binary takes
		# effect on its next restart.
		;;

	*)
		echo "prerm called with unknown argument '$1'" >&2
		exit 1
		;;
esac

exit 0
