<?xml version="1.0" encoding="UTF-8"?>
<!--
  Property-list template for packaging/mac/build.sh, which substitutes the
  at-sign-delimited placeholders below. This file is not a usable Info.plist
  on its own, and build.sh refuses to continue if any placeholder survives.

  Two version keys, because macOS wants numbers and git does not:
  CFBundleShortVersionString is the numeric part alone (what Finder's Get
  Info and the About box show), and REProxyVersion is the full git
  description the binary itself reports with -version.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>@APP_NAME@</string>
	<key>CFBundleExecutable</key>
	<string>@APP_ID@</string>
	<key>CFBundleIconFile</key>
	<string>@APP_ID@</string>
	<key>CFBundleIdentifier</key>
	<string>@BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@APP_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@SHORT_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@SHORT_VERSION@</string>
	<key>REProxyVersion</key>
	<string>@RAW_VERSION@</string>
	<key>LSApplicationCategoryType</key>
	<string>@CATEGORY@</string>
	<key>LSMinimumSystemVersion</key>
	<string>@MIN_MACOS@</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>@COPYRIGHT@</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!--
	  reProxy opens no documents and claims no URL schemes: traffic reaches
	  it through the SOCKS proxy, not through Launch Services.
	-->
</dict>
</plist>
